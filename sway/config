# ============================================================================= 
# SWAY CONFIGURATION - MODULAR ARCHITECTURE
# Author: YoruAkio
# Description: Modular, maintainable Sway configuration with separated concerns
# =============================================================================

# =============================================================================
# CORE SYSTEM CONFIGURATION
# =============================================================================

# Core Dependencies - Color scheme must be loaded first
include ~/.config/sway/generated_colors.conf

# =============================================================================
# MODULAR CONFIGURATION INCLUDES
# =============================================================================

# Variables and Constants - Must be loaded first for other modules to use
include ~/.config/sway/config.d/variables.conf

# Input Configuration - Hardware settings
include ~/.config/sway/config.d/input.conf

# Appearance and Theme - Visual settings
include ~/.config/sway/config.d/appearance.conf

# Window Rules - Application-specific behaviors
include ~/.config/sway/config.d/window_rules.conf

# Keybindings - All keyboard shortcuts
include ~/.config/sway/config.d/keybindings.conf

# Resize Mode - Window resizing functionality
include ~/.config/sway/config.d/resize_mode.conf

# Autostart Applications - Services and startup programs
include ~/.config/sway/config.d/autostart.conf

# =============================================================================
# SYSTEM CONFIGURATION INCLUDES
# =============================================================================

# System-wide configuration modules
include /etc/sway/config.d/*

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
